[Unit]
Description=DSTU Schedule FastAPI Backend Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dstu-schedule/backend
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/dstu-schedule/backend/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
